# VeOmni on AMD ROCm (Instinct MI300 / MI350 series, gfx942 / gfx950).
#
# Base: rocm/primus:v26.4 supplies the OS layer (compilers, ffmpeg, RDMA / AINIC
# userspace). Like docker/cuda, VeOmni runs from a uv venv synced from uv.lock
# (`--extra rocm`): torch 2.12.0+rocm7.14.0 and the ROCm runtime are wheels from
# AMD's release index, so the base image's own /opt/venv stack is not used.
# flash-attn and aiter have no ROCm wheels and are built from source against
# that torch, at the commits rocm/primus:v26.4 ships.
#
# Build from the repo root (the image copies the checkout, like docker/cuda):
#   docker build -f docker/rocm/Dockerfile.ROCm7.14 -t amdagi/veomni:rocm7.14_torch2.12_py3.12 .
FROM rocm/primus:v26.4

ARG MAX_JOBS=16
ENV MAX_JOBS=${MAX_JOBS}

# MIOPEN_DEBUG_FORCE_IMMED_MODE_FALLBACK: skip MIOpen conv3d exhaustive tuning
#   (otherwise the Wan VAE conv3d autotunes for minutes on the first call).
ENV MIOPEN_DEBUG_FORCE_IMMED_MODE_FALLBACK=1 \
    TOKENIZERS_PARALLELISM=false

COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /uvx /bin/
ENV UV_NO_CACHE=1

# --frozen rather than docker/cuda's --locked: verifying the lock re-resolves
# every extra, which downloads each direct-URL wheel (about 4 GB of CUDA torch
# and flash-attn wheels) that this image never installs.
WORKDIR /app
COPY . ./
RUN uv sync \
    --frozen \
    --python /usr/bin/python3.12 \
    --all-packages \
    --extra rocm \
    --dev

# Re-point the base image's ROCm toolchain variables (set for /opt/venv) at the
# rocm-sdk-devel wheel in this venv; hipcc and the JIT/extension builds below
# read them, and a stale LD_LIBRARY_PATH would load the base image's ROCm.
ENV VIRTUAL_ENV=/app/.venv \
    ROCM_PATH=/app/.venv/lib/python3.12/site-packages/_rocm_sdk_devel
ENV ROCM_HOME=$ROCM_PATH \
    HIP_PATH=$ROCM_PATH \
    HIP_CLANG_PATH=$ROCM_PATH/llvm/bin \
    HIP_INCLUDE_PATH=$ROCM_PATH/include \
    HIP_LIB_PATH=$ROCM_PATH/lib \
    HIP_DEVICE_LIB_PATH=$ROCM_PATH/lib/llvm/amdgcn/bitcode \
    PATH=/app/.venv/bin:$ROCM_PATH/bin:$ROCM_PATH/llvm/bin:/opt/openmpi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/opt/openmpi/lib:$ROCM_PATH/lib:$ROCM_PATH/llvm/lib:$ROCM_PATH/lib/host-math/lib:$ROCM_PATH/lib/rocm_sysdeps/lib \
    LIBRARY_PATH=$ROCM_PATH/lib \
    CPATH=$ROCM_PATH/include \
    PKG_CONFIG_PATH=$ROCM_PATH/lib/pkgconfig
RUN rocm-sdk init

# flash-attn and aiter are not in uv.lock, so an exact `uv sync` removes them;
# re-sync with `uv sync --active --inexact --frozen --extra rocm`.
# The base image sets CK_TILE_FLOAT_TO_BFLOAT16_DEFAULT=2 for TransformerEngine
# only after building its flash-attn, so that build used CK's default of 3.
# aiter's runtime JIT keeps the base value, as it does in rocm/primus:v26.4.
ARG FA_COMMIT=6387433156558135a998d5568a9d74c1778666d8
ARG AITER_COMMIT=b5e03ed191fca11ee423226537ef8d9435e432a6
RUN uv pip install ninja wheel \
    && git clone https://github.com/ROCm/flash-attention.git /tmp/flash-attention \
    && cd /tmp/flash-attention \
    && git checkout ${FA_COMMIT} \
    && git submodule update --init --recursive \
    && GPU_ARCHS="gfx942;gfx950" FLASH_ATTENTION_FORCE_BUILD=TRUE CK_TILE_FLOAT_TO_BFLOAT16_DEFAULT=3 \
       uv pip install --no-build-isolation . \
    && cd / && rm -rf /tmp/flash-attention

RUN git clone https://github.com/ROCm/aiter.git /tmp/aiter \
    && cd /tmp/aiter \
    && git checkout ${AITER_COMMIT} \
    && git submodule update --init --recursive \
    && uv pip install . \
    && cd / && rm -rf /tmp/aiter

# aiter's setup.py tries to reinstall triton with whatever pip is on PATH; fail
# the build if that or any other step left the locked packages inconsistent
# (torch pins its triton exactly).
RUN uv pip check
